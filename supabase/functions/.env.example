# Secrets for edge functions when you run them locally with `npm run functions:serve`.
# Copy to supabase/functions/.env. In production set them with, for example:
#   npx supabase secrets set VULT_LLM_PROVIDER=groq VULT_LLM_MODEL=llama-3.3-70b-versatile GROQ_API_KEY=...
#
# Powers Ask Vult and extract-10k. Optional: without a provider Ask Vult uses its built-in answers.
# Providers: anthropic, groq, gemini, openrouter, openai, ollama, lmstudio, custom (any OpenAI-compatible URL).
# Edge functions run in Supabase's cloud, so a local model (ollama) only works with a self-hosted stack:
# point VULT_LLM_BASE_URL at it, for example http://host.docker.internal:11434 with `supabase start`.
VULT_LLM_PROVIDER=
VULT_LLM_MODEL=
VULT_LLM_BASE_URL=

# Only the key for the provider you choose is needed.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VULT_LLM_API_KEY=
