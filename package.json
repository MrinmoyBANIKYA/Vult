{
  "name": "vult",
  "private": true,
  "version": "0.1.0",
  "description": "Vult: the AI-native research desk. Financial models, comps, competitor, company and market analysis, delivered in hours.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "engine": "node --watch-path=server --watch-path=supabase/functions/_shared server/index.js",
    "build": "vite build",
    "report": "node scripts/report.mjs",
    "start": "vite build && node server/index.js",
    "preview": "vite preview",
    "test": "node --test \"src/lib/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "functions:serve": "npx supabase functions serve",
    "functions:deploy": "npx supabase functions deploy ask-vult start-run extract-10k"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@number-flow/react": "0.4.2",
    "@radix-ui/react-checkbox": "1.1.2",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-hover-card": "1.1.2",
    "@radix-ui/react-popover": "1.1.2",
    "@radix-ui/react-slider": "1.2.1",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.4",
    "@supabase/supabase-js": "2.117.1",
    "@tanstack/react-table": "8.20.5",
    "@tesseract.js-data/eng": "1.0.0",
    "@xyflow/react": "12.3.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.0.4",
    "docx": "9.7.2",
    "exceljs": "4.4.0",
    "framer-motion": "11.18.2",
    "lucide-react": "0.460.0",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "2.1.7",
    "recharts": "3.10.1",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.5",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.1"
  }
}
