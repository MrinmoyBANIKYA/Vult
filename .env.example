# Copy this file to .env.local.
#
# Leave both values empty and Vult runs on its built-in demo data: no backend, no sign-in.
# Fill them in to sign in and save your work to Supabase.
#   Local:  run `npm run db:start` and copy "API URL" and "Publishable key" (or "anon key") from its output.
#   Cloud:  Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- Vult engine (npm run engine)
# The engine runs every model call for the Filing desk. You can also pick the provider, model and key in the
# app (Filing desk > Model); choices made there are saved to .vult/engine.json and override these defaults.
#
# Providers: ollama and lmstudio run on this machine, so no filing text leaves it.
#            groq, gemini, openrouter, openai, anthropic and custom (any OpenAI-compatible URL) are hosted.
VULT_LLM_PROVIDER=ollama
VULT_LLM_MODEL=qwen3:8b
# Only for ollama on another host, lmstudio on another port, or custom.
VULT_LLM_BASE_URL=

# Only the key for the hosted provider you use is needed.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: where LibreOffice lives, if it is not in the standard install location. Used to recalculate the
# generated workbook and confirm its formulas agree with the engine.
VULT_SOFFICE=

# ---------------------------------------------------------------- free market data
# SEC EDGAR asks every client to identify itself with a name and an email address.
VULT_SEC_USER_AGENT=

# ---------------------------------------------------------------- deploying the engine on a server
# On a laptop the engine answers only on localhost and needs no sign-in. On a server set
# VULT_ENGINE_ALLOW_REMOTE=1: every request must then carry a Supabase access token (checked against
# SUPABASE_URL's signing keys, or SUPABASE_JWT_SECRET for legacy projects) or VULT_ENGINE_TOKEN.
VULT_ENGINE_ALLOW_REMOTE=
VULT_ENGINE_TOKEN=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# json: one log line per request, for a log collector.
VULT_ENGINE_LOG=
# Model calls at a time (1 for one GPU).
VULT_MODEL_CONCURRENCY=1
