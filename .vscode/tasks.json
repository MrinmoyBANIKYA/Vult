{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vult: dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^x^" },
        "background": { "activatesByDefault": true, "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    { "label": "Vult: lint", "type": "npm", "script": "lint", "problemMatcher": ["$eslint-stylish"] },
    { "label": "Vult: build", "type": "npm", "script": "build", "group": { "kind": "build", "isDefault": true } }
  ]
}
